# Fill in the key, endpoint, and both model IDs supported by that endpoint.
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KIMI_MODEL=moonshotai/kimi-k2
AUTORESEARCH_SANDBOX_MODEL=moonshotai/kimi-k2

# Enable repository-owned experiments and keep CPU/GPU execution on this Docker host.
AUTORESEARCH_GEN_EXPERIMENT=1
AUTORESEARCH_AGENTIC_IMPROVE=1
AUTORESEARCH_REAL_SEARCH=1
AUTORESEARCH_REPO_MODE=auto
AUTORESEARCH_REPO_SPLIT=0
# For GPU tasks, replace this with the device IDs allocated to this controller.
AUTORESEARCH_LOCAL_GPU=0

# Persist session databases, checkpoints, and reports outside /tmp for real use.
AUTORESEARCH_WEB_WORKDIR=./workspace/web
AUTORESEARCH_WEB_HOST=127.0.0.1
AUTORESEARCH_WEB_PORT=8300

# The sandbox endpoint inherits OPENROUTER_BASE_URL when this override is unset.
# AUTORESEARCH_SANDBOX_BASE_URL=https://openrouter.ai/api/v1
# Set to default to omit reasoning_effort if the endpoint does not support it.
AUTORESEARCH_SANDBOX_REASONING_EFFORT=none

# Optional endpoint-specific JSON fields. Use values documented by your provider.
# AUTORESEARCH_LLM_EXTRA_BODY={}
# Shared completion ceiling for direct/Web and sandbox LLM calls. DeepSeek Flash 0731 was
# wire-probed successfully at 262144; confirm support before using it with another endpoint.
# AUTORESEARCH_LLM_MAX_TOKENS=262144
# AUTORESEARCH_WEB_LLM_MAX_TOKENS=262144
# AUTORESEARCH_SANDBOX_LLM_MAX_TOKENS=262144
# For DeepSeek Flash 0731 reasoning=max, edit both model IDs above to your endpoint's aliases,
# then enable the following settings only if that endpoint supports them:
# VIBE_REASONING_EFFORT=max
# AUTORESEARCH_SANDBOX_REASONING_EFFORT=max

# Optional caches: repository-experiment caches are session-local; setup recovery uses ~/.cache.
# AUTORESEARCH_CLONE_MIRROR_DIR=/absolute/path/to/git-mirrors
# AUTORESEARCH_SANDBOX_PKG_CACHE_DIR=/absolute/path/to/package-cache
# AUTORESEARCH_SANDBOX_HF_HOME=/absolute/path/to/huggingface-cache
# AUTORESEARCH_SANDBOX_DATA_ROOT=/absolute/path/to/task-data
# AUTORESEARCH_SANDBOX_CACHE=/absolute/path/to/sandbox-cache
# AUTORESEARCH_SANDBOX_IMAGE=ghcr.io/openhands/agent-server:1.19.1-python

# Off by default: enabling this selects the deployment-specific mirror configured in code.
AUTORESEARCH_SANDBOX_PIP_MIRROR=0
